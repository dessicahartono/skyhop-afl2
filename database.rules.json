{
  "rules": {
    "flights": {
      ".read": true,
      ".write": true,
      ".indexOn": ["rute"]
    },
    "bookings": {
      ".read": true,
      ".write": true,
      ".indexOn": ["flightId"]
    },
    "kursi": {
      ".read": true,
      ".write": true,
      "$flightId": {
        "$nomorKursi": {
          ".validate": "!data.exists() || data.val() === newData.val()"
        }
      }
    },
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "bookings": {
          "$kode": {
            ".write": "!newData.exists()"
          }
        }
      }
    }
  }
}
